generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BusType {
  AC
  NON_AC
  SLEEPER
  DOUBLE_DECKER
}

enum SeatStatus {
  AVAILABLE
  BOOKED
  LOCKED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  phone     String?
  role      Role      @default(USER)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Route {
  id         String     @id @default(cuid())
  fromCity   String
  toCity     String
  distanceKm Int
  durationMinutes Int
  imageUrl   String?
  schedules  Schedule[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([fromCity, toCity])
}

model Bus {
  id          String     @id @default(cuid())
  busNumber   String     @unique
  operator    String
  type        BusType    @default(AC)
  totalSeats  Int        @default(40)
  amenities   String[]   @default([])
  rating      Float      @default(4.5)
  schedules   Schedule[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Schedule {
  id            String    @id @default(cuid())
  routeId       String
  busId         String
  departureTime DateTime
  arrivalTime   DateTime
  price         Int
  availableSeats Int
  route         Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  bus           Bus       @relation(fields: [busId], references: [id], onDelete: Cascade)
  seats         Seat[]
  bookings      Booking[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([departureTime])
  @@index([routeId, departureTime])
}

model Seat {
  id           String     @id @default(cuid())
  scheduleId   String
  seatNumber   String
  status       SeatStatus @default(AVAILABLE)
  bookingId    String?
  schedule     Schedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  booking      Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  lockedUntil  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([scheduleId, seatNumber])
  @@index([scheduleId])
}

model Booking {
  id              String        @id @default(cuid())
  bookingCode     String        @unique @default(cuid())
  userId          String
  scheduleId      String
  seatNumbers     String[]
  totalAmount     Int
  status          BookingStatus @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  passengerName   String
  passengerPhone  String
  passengerEmail  String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule        Schedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  seats           Seat[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([scheduleId])
}
